# deploy/.env — read by docker compose (Caddy + torClient). setup.sh fills in
# the first three. Never commit this file.

# The VPS's public IP (HTTPS from Caddy's own CA; browsers warn until you trust
# it) or a domain pointing at the VPS (real Let's Encrypt certificate).
SITE_ADDRESS=203.0.113.10
# Login for the UI, API, player and keys.
AUTH_USER=admin
# bcrypt hash of the password, in single quotes so compose leaves the $ alone.
# Make one with: docker run --rm caddy:2.10 caddy hash-password --plaintext 'your-password'
AUTH_HASH='$2a$14$replace.with.your.own.hash.................................'

# --- torClient, sized for a 4 vCPU / 8 GB VPS ---------------------------------
# (paths, LISTEN_ADDR, HLS_KEY_URI_BASE and SERVE_MEDIA are set by the image
# and docker-compose.yml)

# CPU encoding: a VPS has no NVENC. One encode at a time using every vCPU:
# ~7 min per 24-min episode on 4 vCPUs, ~535 MB per episode.
ENCODER=cpu
FFMPEG_THREADS=4
MAX_FFMPEG_WORKERS=1
H264_PRESET=veryfast
H264_CRF_BD=24
H264_CRF_WEB=25
FAST_PATH_MAX_KBPS=4000

# Downloads run ahead of the encoder; 2 keeps the disk from filling with raws.
MAX_CONCURRENT_TORRENTS=2
TORRENT_PORT=42069
DHT=true
PEER_LIMIT=50
DOWNLOAD_TIMEOUT_MINUTES=45

# Disk: cap everything torClient stores (raws in progress + library), in GB.
# Set it to ~80% of the VPS disk once you know its size; 0 = no cap.
MAX_STORAGE_GB=0
# At the cap: false = refuse new downloads; true = delete the oldest episodes.
STORAGE_AUTO_DELETE=false
MIN_FREE_DISK_GB=10
WORK_TTL_HOURS=3
FAILED_WORK_TTL_HOURS=72

# AniList discovery defaults (the UI can override per search)
DISCOVERY_SOURCES=
DISCOVERY_RESOLUTION=1080
DISCOVERY_PREFERRED_GROUPS=
DISCOVERY_EXCLUDE=

HLS_ENCRYPT=true
LOG_LEVEL=info
