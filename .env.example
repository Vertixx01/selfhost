# Directories
WORK_DIR=./work
OUTPUT_DIR=./output
TORRENT_DIR=./torrents
# SQLite database (job queue + state)
DB_PATH=./data/torclient.db
# Content-addressed font cache (encode-server only)
FONT_CACHE_DIR=./fonts
# HLS AES keys. Must NOT be inside OUTPUT_DIR.
KEY_DIR=./keys

# Concurrency
MAX_CONCURRENT_TORRENTS=3
MAX_FFMPEG_WORKERS=1

# Network
TORRENT_PORT=42069
DHT=true
PEER_LIMIT=50

# Videos smaller than this are treated as samples/extras
MIN_VIDEO_FILE_MB=50

# Torrent timeouts
RESOLVE_ATTEMPTS=3
RESOLVE_TIMEOUT_SECONDS=60
RESOLVE_BACKOFF_SECONDS=10
# Fail if no peer and no data after this long
NO_PEERS_TIMEOUT_SECONDS=120
# Fail if downloaded bytes stop increasing for this long
STALL_TIMEOUT_MINUTES=5
# Hard cap per episode download (raise for large BD releases)
DOWNLOAD_TIMEOUT_MINUTES=30

# FFmpeg (jellyfin-ffmpeg)
FFMPEG_PATH=/usr/lib/jellyfin-ffmpeg/ffmpeg
FFPROBE_PATH=/usr/lib/jellyfin-ffmpeg/ffprobe
# Optional fallback for subtitle/font extraction (mkvtoolnix). Name on PATH or full path.
MKVEXTRACT_PATH=mkvextract

# Transcode
H264_CRF_BD=24
H264_MAXRATE_BD=6000k
H264_BUFSIZE_BD=12000k
H264_CRF_WEB=25
H264_MAXRATE_WEB=5000k
H264_BUFSIZE_WEB=20000k
H264_PRESET=veryfast
H264_TUNE=animation
AUDIO_BITRATE=128k
AUDIO_CHANNELS=2
AUDIO_SAMPLERATE=48000
SEGMENT_DURATION=6
# Copy the source 1080p stream unchanged only if it's at most this many kbit/s
# (0 = always copy when possible). Streaming WEB-DLs (6-9 Mbit/s) get re-encoded.
FAST_PATH_MAX_KBPS=4000
# ffmpeg CPU threads (0 = all cores). Set to the VPS vCPU count.
FFMPEG_THREADS=0

# Encoder: auto (NVIDIA GPU + CPU hybrid when NVENC works, else CPU), cpu, or gpu
ENCODER=auto
# Concurrent NVENC encodes. Consumer cards have one encoder engine: 1 is fastest.
GPU_WORKERS=1
# NVENC preset p1 (fastest) .. p7 (slowest); cq per source type (~x264 CRF + 6)
NVENC_PRESET=p1
NVENC_CQ_BD=30
NVENC_CQ_WEB=31

# Encryption (AES-128 HLS)
HLS_ENCRYPT=true
HLS_KEY_URI_BASE=https://keys.example.com/keys
# CORS origin for GET /keys/... (browser players fetch keys cross-origin). Restrict to your frontend's origin.
KEY_CORS_ORIGIN=*

# Intro detection: episodes needed before series-level fingerprint correlation runs
FINGERPRINT_MIN_EPISODES=3

# AniList discovery (POST /api/anilist/{id}/episodes)
# Sources to search: animetosho,seadex,subsplease,nyaa,yameii,toonshub (empty = all)
DISCOVERY_SOURCES=
# Preferred resolution for auto-pick
DISCOVERY_RESOLUTION=1080
# Release groups to prefer, in order (e.g. SubsPlease,Erai-raws)
DISCOVERY_PREFERRED_GROUPS=
# Titles containing any of these (case-insensitive) are never picked
DISCOVERY_EXCLUDE=

# Cleanup (TTL counts from when the episode reached done/failed)
WORK_TTL_HOURS=3
FAILED_WORK_TTL_HOURS=72
CLEANUP_INTERVAL_MINUTES=15
# /ready warns when work or output disk has less free space than this
MIN_FREE_DISK_GB=10
# Cap on everything torClient stores (downloads in progress + library), in GB. 0 = no cap.
MAX_STORAGE_GB=0
# When the cap is hit: false = fail the new download; true = delete the oldest episodes to make room
STORAGE_AUTO_DELETE=false

# HTTP Server
LISTEN_ADDR=:8080
# Serve OUTPUT_DIR at /media and a test player at /play (normally a CDN/nginx serves output/)
SERVE_MEDIA=false

# Logging: debug, info, warn, error
LOG_LEVEL=info
